<?php

declare(strict_types=1);

// Data for the master schedule page: reference lists, the selected
// semester and schedule record, validation results, filters, pagination.

// Only Fall 2026 and Spring 2027 are selectable. Historical records remain in MySQL.
$semesters = all_rows(
    $pdo,
    "SELECT s.semester_ID, s.semester_Name
     FROM Semester s
     WHERE s.semester_Name IN ('Fall 2026', 'Spring 2027')
       AND EXISTS (
           SELECT 1 FROM Course_Section cs
           WHERE cs.semester_ID = s.semester_ID AND cs.is_Cancelled = 0
       )
     ORDER BY CASE s.semester_Name
         WHEN 'Fall 2026' THEN 1
         WHEN 'Spring 2027' THEN 2
         ELSE 3 END"
);

$semesterIDs = array_map(
	static fn(array $row): int => (int) $row['semester_ID'],
	$semesters
);

$semesterID = get_int('semester');

// Invalid or historical semester IDs fall back to Fall 2026.
if ($semesterID === null || !in_array($semesterID, $semesterIDs, true)) {

	$semesterID = $semesterIDs === []
		? 0
		: (int) $semesterIDs[0];
}

$semester = one(
	$pdo,
	'SELECT * FROM Semester WHERE semester_ID = ?',
	[$semesterID]
);

$schedule = $semester !== null ? master_schedule_get($pdo, $semesterID) : null;

$validation = $semester !== null
	? validate_semester_schedule($pdo, $semesterID)
	: ['rows' => [], 'stats' => [], 'issues' => [], 'valid' => false];

$scheduleLocked = $semester !== null
	? semester_schedule_locked($pdo, $semesterID)
	: false;

// Filter controls (server-side)
$filterDepartment = get_int('dept');
$filterDepartmentName = get_str('department_name', 100);
$filterFaculty = get_int('faculty');
$filterFacultyName = get_str('faculty_name', 100);
$filterDay = get_str('day', 10); // compatibility with older links
$selectedDayPatterns = $_GET['days'] ?? [];
if (!is_array($selectedDayPatterns)) $selectedDayPatterns = [];
$selectedDayPatterns = array_values(array_intersect(['MW','TT','F'], array_map('strval', $selectedDayPatterns)));
$filterCourse = get_str('course', 100);
$filterRoom = get_str('room', 50);

$departments = all_rows(
	$pdo,
	'SELECT dept_ID, dept_Name FROM Department ORDER BY dept_Name'
);

// Show only faculty teaching active sections in the selected semester.
// DISTINCT avoids repeated dropdown entries for faculty teaching multiple sections.
$facultyList = all_rows(
    $pdo,
    "SELECT DISTINCT f.faculty_ID, CONCAT(u.first_Name, ' ', u.last_Name) AS name
     FROM Course_Section cs
     JOIN Faculty f ON f.faculty_ID = cs.faculty_ID
     JOIN User u ON u.user_ID = f.faculty_ID
     WHERE cs.semester_ID = ? AND cs.is_Cancelled = 0
     ORDER BY name, f.faculty_ID",
    [$semesterID]
);

// Only departments represented by active sections in this semester.
$departments = all_rows(
    $pdo,
    "SELECT DISTINCT d.dept_ID, d.dept_Name
     FROM Department d
     JOIN Course c ON c.dept_ID = d.dept_ID
     JOIN Course_Section cs ON cs.course_ID = c.course_ID
     WHERE cs.semester_ID = ? AND cs.is_Cancelled = 0
     ORDER BY d.dept_Name",
    [$semesterID]
);

// Available days are derived from the schedule rows, not a fixed seven-day menu.
$availableMeetingDays = [];
foreach ($validation['rows'] as $scheduleRow) {
    foreach (($scheduleRow['days'] ?? []) as $meetingDay) {
        $availableMeetingDays[$meetingDay] = true;
    }
}
$daySequence = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
$availableMeetingDays = array_values(array_filter(
    $daySequence,
    static fn(string $day): bool => isset($availableMeetingDays[$day])
));

$timeSlots = all_rows(
	$pdo,
	'SELECT time_Slot_ID FROM Time_Slot ORDER BY time_Slot_ID'
);

$lectureRooms = all_rows(
	$pdo,
	"SELECT l.lecture_ID, r.room_Number, b.Bldg_Name
	FROM Lecture l
	JOIN Room r ON r.room_ID = l.lecture_ID
	JOIN Building b ON b.Bldg_ID = r.Bldg_ID
	ORDER BY b.Bldg_Name, r.room_Number"
);

$labRooms = all_rows(
	$pdo,
	"SELECT b.lab_ID, r.room_Number, bl.Bldg_Name
	FROM Lab b
	JOIN Room r ON r.room_ID = b.lab_ID
	JOIN Building bl ON bl.Bldg_ID = r.Bldg_ID
	ORDER BY bl.Bldg_Name, r.room_Number"
);

// Apply the filters to the loaded rows
$rows = $validation['rows'];

// Resolve text filters against the semester's reference data. Multiple people
// with the same name match independently; IDs remain supported for old links.
$matchingDepartmentIDs = [];
if ($filterDepartmentName !== '') {
    foreach ($departments as $department) {
        if (stripos((string)$department['dept_Name'], $filterDepartmentName) !== false) {
            $matchingDepartmentIDs[] = (int)$department['dept_ID'];
        }
    }
}
$matchingFacultyIDs = [];
if ($filterFacultyName !== '') {
    foreach ($facultyList as $member) {
        if (stripos((string)$member['name'], $filterFacultyName) !== false) {
            $matchingFacultyIDs[] = (int)$member['faculty_ID'];
        }
    }
}
if ($filterDepartmentName !== '') {
    $rows = array_values(array_filter($rows, static fn(array $r): bool => in_array((int)$r['dept_ID'], $matchingDepartmentIDs, true)));
}
if ($filterFacultyName !== '') {
    $rows = array_values(array_filter($rows, static fn(array $r): bool => in_array((int)$r['faculty_ID'], $matchingFacultyIDs, true)));
}
if ($selectedDayPatterns !== []) {
    $rows = array_values(array_filter($rows, static function(array $r) use ($selectedDayPatterns): bool {
        $days = $r['days'] ?? [];
        if (!is_array($days)) return false;
        $daySet = array_fill_keys($days, true);
        return (in_array('MW', $selectedDayPatterns, true) && isset($daySet['Monday'], $daySet['Wednesday']))
            || (in_array('TT', $selectedDayPatterns, true) && isset($daySet['Tuesday'], $daySet['Thursday']))
            || (in_array('F', $selectedDayPatterns, true) && isset($daySet['Friday']) && count($daySet) === 1);
    }));
}


if ($filterDepartment !== null) {
	$rows = array_values(array_filter(
		$rows,
		static fn(array $row): bool => (int) $row['dept_ID'] === $filterDepartment
	));
}

if ($filterFaculty !== null) {
	$rows = array_values(array_filter(
		$rows,
		static fn(array $row): bool => (int) $row['faculty_ID'] === $filterFaculty
	));
}

if ($filterDay !== '') {
	$rows = array_values(array_filter(
		$rows,
		static fn(array $row): bool => in_array($filterDay, $row['days'], true)
	));
}

if ($filterCourse !== '') {
	$rows = array_values(array_filter(
		$rows,
		static fn(array $row): bool => (
            stripos((string) $row['course_Name'], $filterCourse) !== false
            || stripos((string) $row['course_ID'], $filterCourse) !== false
        )
	));
}

if ($filterRoom !== '') {
	$rows = array_values(array_filter(
		$rows,
		static fn(array $row): bool => $row['room_Label'] !== null
			&& stripos((string) $row['room_Label'], $filterRoom) !== false
	));
}

// Interleave meeting patterns rather than placing every Monday/Wednesday
// section before every Tuesday/Thursday section. This is display-only:
// database times, rooms, and faculty assignments remain untouched.
// Deterministic CRN-based ordering prevents duplicate/missing rows on pages.
$weekdayOrder = ['Monday' => 1, 'Tuesday' => 2, 'Wednesday' => 3, 'Thursday' => 4, 'Friday' => 5, 'Saturday' => 6, 'Sunday' => 7];
$dayGroups = [];
foreach ($rows as $row) {
    $days = $row['days'] ?? [];
    if (!is_array($days)) $days = [];
    usort($days, static fn($a, $b) => ($weekdayOrder[$a] ?? 8) <=> ($weekdayOrder[$b] ?? 8));
    $key = implode('|', $days) ?: 'Unscheduled';
    $dayGroups[$key][] = $row;
}
foreach ($dayGroups as &$group) {
    usort($group, static function (array $a, array $b): int {
        return [(string) ($a['start_Time'] ?? ''), (int) ($a['CRN'] ?? 0)]
            <=> [(string) ($b['start_Time'] ?? ''), (int) ($b['CRN'] ?? 0)];
    });
}
unset($group);
uksort($dayGroups, static function (string $a, string $b) use ($weekdayOrder): int {
    $first = static fn(string $k): int => $weekdayOrder[explode('|', $k)[0]] ?? 8;
    return [$first($a), $a] <=> [$first($b), $b];
});
$rows = [];
while ($dayGroups !== []) {
    foreach (array_keys($dayGroups) as $key) {
        $rows[] = array_shift($dayGroups[$key]);
        if ($dayGroups[$key] === []) unset($dayGroups[$key]);
    }
}

// Server-side pagination over the filtered set
$perPage = 50;
$page = max(1, get_int('page') ?? 1);
$totalRows = count($rows);
$totalPages = max(1, (int) ceil($totalRows / $perPage));
$page = min($page, $totalPages);
$offset = ($page - 1) * $perPage;
$pageRows = array_slice($rows, $offset, $perPage);

// Section being edited
$editCRN = get_int('edit');
$editSection = null;

if ($editCRN !== null) {
	$editSection = one(
		$pdo,
		'SELECT * FROM Course_Section WHERE CRN = ?',
		[$editCRN]
	);
}

// Recent schedule audit events
$auditEntries = all_rows(
	$pdo,
	"SELECT a.created_At, a.action, a.details,
			CONCAT(u.first_Name, ' ', u.last_Name) AS actor_Name
	FROM Audit_Log a
	LEFT JOIN User u ON u.user_ID = a.actor_User_ID
	WHERE a.entity_Type = 'Master_Schedule'
	ORDER BY a.created_At DESC
	LIMIT 10"
);
